{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "avatar_color": { "type": "string" },
        "current_channel": { "type": "string" },
        "is_speaking": { "type": "boolean" },
        "is_muted": { "type": "boolean" },
        "is_deafened": { "type": "boolean" },
        "has_video": { "type": "boolean" },
        "is_screen_sharing": { "type": "boolean" }
      },
      "required": ["id", "username"]
    },
    "message": {
      "title": "Message",
      "description": "Chat message",
      "type": "object",
      "properties": {
        "channel_id": { "type": "string" },
        "sender_id": { "type": "string" },
        "sender_name": { "type": "string" },
        "avatar_color": { "type": "string" },
        "content": { "type": "string" },
        "attachment_url": { "type": "string" },
        "attachment_type": { "type": "string" },
        "attachment_name": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["channel_id", "sender_id", "sender_name", "content", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "messages/{messageId}": {
      "schema": "message",
      "description": "Chat messages"
    }
  }
}
