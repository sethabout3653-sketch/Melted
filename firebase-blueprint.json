{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "Chat or direct message item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "channel_id": { "type": "string", "maxLength": 128 },
        "sender_id": { "type": "string", "maxLength": 128 },
        "sender_name": { "type": "string", "maxLength": 64 },
        "avatar_color": { "type": "string", "maxLength": 32 },
        "sender_avatar_url": { "type": "string", "maxLength": 131072 },
        "content": { "type": "string", "maxLength": 2048 },
        "attachment_url": { "type": "string", "maxLength": 524288 },
        "attachment_type": { "type": "string", "maxLength": 64 },
        "attachment_name": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "created_at": { "type": "number" }
      },
      "required": ["id", "channel_id", "sender_id", "sender_name"]
    },
    "Deletion": {
      "title": "Deletion",
      "description": "Tombstone for deleted messages",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "deleted_at": { "type": "number" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Global and private chat messages collection (Firebase persists chat only)"
    },
    "/deletions/{messageId}": {
      "schema": { "$ref": "#/entities/Deletion" },
      "description": "Shared tombstones for permanent message deletion sync"
    }
  }
}

