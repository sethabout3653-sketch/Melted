{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "Chat message entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "text", "userId", "userName", "createdAt"]
    },
    "HighScore": {
      "title": "HighScore",
      "description": "Game high score entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "score": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "gameId", "userId", "userName", "score", "createdAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "User cloud synced favorites entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "favoriteGameIds": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "favoriteGameIds", "updatedAt"]
    },
    "Presence": {
      "title": "Presence",
      "description": "User online presence heartbeat entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string", "maxLength": 100 },
        "avatar_color": { "type": "string" },
        "avatar_url": { "type": "string" },
        "current_channel": { "type": "string" },
        "activity": { "type": "string" },
        "is_speaking": { "type": "boolean" },
        "is_muted": { "type": "boolean" },
        "is_deafened": { "type": "boolean" },
        "has_video": { "type": "boolean" },
        "is_screen_sharing": { "type": "boolean" },
        "lastSeen": { "type": "number" },
        "updated_at": { "type": "number" }
      },
      "required": ["id", "username", "lastSeen"]
    },
    "WebRtcSignal": {
      "title": "WebRtcSignal",
      "description": "Peer to peer WebRTC cloud signaling message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUserId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "signal": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "fromUserId", "targetUserId", "signal", "createdAt"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Global and room chat messages"
    },
    "/highScores/{scoreId}": {
      "schema": { "$ref": "#/entities/HighScore" },
      "description": "Game high scores"
    },
    "/userFavorites/{userId}": {
      "schema": { "$ref": "#/entities/UserFavorite" },
      "description": "User cloud synced favorites"
    },
    "/presence/{userId}": {
      "schema": { "$ref": "#/entities/Presence" },
      "description": "Real-time user presence and online counter records"
    },
    "/webrtcSignals/{signalId}": {
      "schema": { "$ref": "#/entities/WebRtcSignal" },
      "description": "Real-time WebRTC audio/video/screenshare cloud signaling messages"
    }
  }
}
