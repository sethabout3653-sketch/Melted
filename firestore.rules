rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }

    match /messages/{messageId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(messageId)
        && request.resource.data.keys().hasAll(['id', 'text', 'userId', 'userName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'text', 'userId', 'userName', 'createdAt'])
        && request.resource.data.id == messageId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 100;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /highScores/{scoreId} {
      allow list: if true;
      allow get: if true;
      allow create: if isSignedIn()
        && isValidId(scoreId)
        && request.resource.data.keys().hasAll(['id', 'gameId', 'userId', 'userName', 'score', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'gameId', 'userId', 'userName', 'score', 'createdAt'])
        && request.resource.data.id == scoreId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is number && request.resource.data.score >= 0;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /userFavorites/{userId} {
      allow get: if isSignedIn() && userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && userId == request.auth.uid
        && isValidId(userId)
        && request.resource.data.keys().hasAll(['id', 'userId', 'favoriteGameIds', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'userId', 'favoriteGameIds', 'updatedAt'])
        && request.resource.data.id == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.favoriteGameIds is list
        && request.resource.data.favoriteGameIds.size() <= 1000;
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }
  }
}
