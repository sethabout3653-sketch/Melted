{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frosted",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws-db"]
  }
}
