{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frosted",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "SIGNALING_HUB", "class_name": "SignalingHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingHub"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws-db*", "/wisp*"]
  }
}
